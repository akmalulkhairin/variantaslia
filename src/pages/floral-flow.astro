---
import FloralFlowInvitation from '../components/FloralFlowInvitation';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Taslia &amp; Varian — Floral Flow Preview</title>
    <meta name="description" content="Mobile-first floral wedding invitation flow for Taslia and Varian · 04 June 2026 · Aceh, Indonesia" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Great+Vibes&family=Jost:wght@300;400&display=swap" rel="stylesheet" />
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body { background: #f3f3f1; }
      .floral-flow {
        --ff-green: #758966;
        --ff-dark: #242424;
        --ff-muted: rgba(36,36,36,0.58);
        --ff-line: rgba(120,122,111,0.24);
        min-height: 100svh;
        color: var(--ff-dark);
        font-family: 'Jost', sans-serif;
        position: relative;
        overflow-x: hidden;
      }
      .ff-bg {
        position: fixed;
        inset: 0;
        z-index: 0;
        background:
          linear-gradient(rgba(255,255,255,0.2), rgba(255,255,255,0.2)),
          url('/reference/floral-flow-backdrop.png') center / cover no-repeat;
      }
      .ff-bg::after {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(255,255,255,0.18);
      }
      .ff-lang {
        position: fixed;
        z-index: 30;
        top: 16px;
        right: 16px;
        display: flex;
        overflow: hidden;
        border: 1px solid rgba(117,137,102,0.22);
        border-radius: 999px;
        background: rgba(255,255,255,0.78);
        backdrop-filter: blur(16px);
      }
      .ff-lang button {
        border: 0;
        background: transparent;
        padding: 8px 13px;
        color: rgba(36,36,36,0.55);
        font-size: 10px;
        letter-spacing: 0.18em;
      }
      .ff-lang .on {
        background: var(--ff-green);
        color: #fff;
      }
      .ff-cover,
      .ff-content {
        position: relative;
        z-index: 1;
      }
      .floral-flow[data-opened="true"] .ff-cover {
        display: none;
      }
      .ff-cover {
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 22px;
        padding: 56px 24px 38px;
        text-align: center;
        animation: ffIn 0.8s ease both;
      }
      .ff-cover-kicker,
      .ff-label,
      .ff-hint {
        font-size: 10px;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: rgba(36,36,36,0.62);
      }
      .ff-seal-btn {
        border: 0;
        background: transparent;
        padding: 0;
        cursor: pointer;
        filter: drop-shadow(0 20px 50px rgba(49,68,43,0.16));
      }
      .ff-seal {
        width: min(58vw, 230px);
        height: min(58vw, 230px);
        display: block;
        animation: ffPulse 4s ease-in-out infinite;
      }
      .ff-cover h1 {
        font-family: 'Cormorant Garamond', serif;
        font-style: italic;
        font-weight: 400;
        font-size: clamp(46px, 13vw, 78px);
        line-height: 0.9;
        color: var(--ff-green);
        text-shadow: 0 1px 0 rgba(255,255,255,0.64);
      }
      .ff-cover h1 span {
        color: #c48b9a;
      }
      .ff-open,
      .ff-form button,
      .ff-save a {
        min-height: 48px;
        border: 0;
        border-radius: 999px;
        background: var(--ff-green);
        color: #fff;
        box-shadow: 0 16px 36px rgba(49,68,43,0.22);
        font-family: 'Jost', sans-serif;
        font-size: 10px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        padding: 0 26px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
      }
      .ff-content {
        display: grid;
        gap: 28px;
        padding: 34px 18px 54px;
        animation: ffIn 0.8s ease both;
      }
      .floral-flow[data-opened="false"] .ff-content {
        display: none;
      }
      .ff-card {
        position: relative;
        width: min(100%, 390px);
        margin: 0 auto;
        padding: 44px 26px;
        border-radius: 26px;
        background: rgba(255,255,255,0.93);
        box-shadow: 0 24px 70px rgba(49,68,43,0.15);
        text-align: center;
        overflow: hidden;
      }
      .ff-card::before {
        content: '';
        position: absolute;
        inset: 12px;
        border: 1px solid rgba(117,137,102,0.1);
        border-radius: 20px;
        pointer-events: none;
      }
      .ff-corner {
        position: absolute;
        width: 48px;
        height: 48px;
        border-color: var(--ff-line);
        pointer-events: none;
      }
      .ff-corner-tl { top: 24px; left: 24px; border-top: 2px solid; border-left: 2px solid; border-radius: 12px 0 0; }
      .ff-corner-tr { top: 24px; right: 24px; border-top: 2px solid; border-right: 2px solid; border-radius: 0 12px 0 0; }
      .ff-corner-bl { bottom: 24px; left: 24px; border-bottom: 2px solid; border-left: 2px solid; border-radius: 0 0 0 12px; }
      .ff-corner-br { bottom: 24px; right: 24px; border-bottom: 2px solid; border-right: 2px solid; border-radius: 0 0 12px; }
      .ff-invite {
        padding-top: 54px;
      }
      .ff-plaque {
        width: min(66vw, 260px);
        aspect-ratio: 1.42;
        margin: 30px auto;
        background: var(--ff-green);
        color: #fff;
        clip-path: polygon(18% 0, 82% 0, 100% 22%, 100% 78%, 82% 100%, 18% 100%, 0 78%, 0 22%);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 13px;
      }
      .ff-plaque span {
        font-family: 'Great Vibes', 'Cormorant Garamond', serif;
        font-size: clamp(42px, 12vw, 62px);
        line-height: 0.82;
      }
      .ff-plaque i {
        width: 72%;
        height: 2px;
        background: rgba(8,8,8,0.78);
      }
      .ff-date {
        margin-top: 8px;
        font-size: 18px;
        color: rgba(36,36,36,0.74);
      }
      .ff-time,
      .ff-place,
      .ff-venue {
        margin-top: 10px;
        color: var(--ff-muted);
        font-size: 15px;
      }
      .ff-intro,
      .ff-story p,
      .ff-location p {
        margin: 26px auto 0;
        max-width: 310px;
        font-family: 'Cormorant Garamond', serif;
        font-style: italic;
        font-size: 20px;
        line-height: 1.45;
        color: rgba(36,36,36,0.66);
      }
      .ff-story h2,
      .ff-location h2 {
        margin-top: 20px;
        font-family: 'Cormorant Garamond', serif;
        font-style: italic;
        font-weight: 400;
        font-size: clamp(36px, 11vw, 58px);
        line-height: 1;
        color: var(--ff-green);
      }
      .ff-form {
        margin-top: 28px;
        display: grid;
        gap: 15px;
      }
      .ff-form input,
      .ff-form textarea {
        width: 100%;
        border: 0;
        border-bottom: 1px solid rgba(117,137,102,0.28);
        background: transparent;
        padding: 11px 0;
        color: var(--ff-dark);
        font-family: 'Jost', sans-serif;
        font-size: 14px;
        outline: none;
        resize: none;
      }
      .ff-error {
        color: #8f5964;
        font-size: 11px;
      }
      .ff-thanks {
        margin-top: 28px;
        font-family: 'Cormorant Garamond', serif;
        font-style: italic;
        font-size: 28px;
        color: var(--ff-green);
      }
      .ff-save {
        display: grid;
        gap: 12px;
      }
      .ff-save strong {
        display: block;
        font-family: 'Cormorant Garamond', serif;
        font-style: italic;
        font-weight: 400;
        font-size: clamp(118px, 34vw, 178px);
        line-height: 0.78;
        color: var(--ff-green);
      }
      .ff-save span {
        margin-bottom: 14px;
        color: var(--ff-muted);
      }
      .ff-save a:last-child {
        background: rgba(255,255,255,0.5);
        color: var(--ff-green);
        border: 1px solid rgba(117,137,102,0.28);
        box-shadow: none;
      }
      .ff-footer {
        width: min(100%, 390px);
        margin: 0 auto;
        padding: 36px 20px 12px;
        text-align: center;
        font-family: 'Great Vibes', 'Cormorant Garamond', serif;
        font-size: 48px;
        color: var(--ff-green);
        text-shadow: 0 1px 0 rgba(255,255,255,0.72);
      }
      @keyframes ffIn {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
      }
      @keyframes ffPulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.035); }
      }
      @media (min-width: 720px) {
        .ff-content {
          padding-block: 54px 80px;
        }
      }
    </style>
  </head>
  <body>
    <FloralFlowInvitation client:load />
    <script>
      const lockScroll = () => {
        document.body.style.overflow = 'hidden';
        document.documentElement.style.overflow = 'hidden';
      };
      const unlockScroll = () => {
        document.body.style.overflow = '';
        document.documentElement.style.overflow = '';
      };
      lockScroll();
      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        if (!target.closest('.ff-open, .ff-seal-btn')) return;
        const root = document.querySelector('.floral-flow');
        const content = document.querySelector('.ff-content');
        if (!root || !content) return;
        root.setAttribute('data-opened', 'true');
        content.setAttribute('aria-hidden', 'false');
        unlockScroll();
        requestAnimationFrame(() => window.scrollTo({ top: 0, behavior: 'smooth' }));
      });
    </script>
  </body>
</html>
