---
import RoseArchInvitation from '../components/RoseArchInvitation';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Taslia &amp; Varian — Rose Arch Preview</title>
    <meta name="description" content="Floral rose arch wedding invitation preview for Taslia and Varian · 04 June 2026 · Aceh, Indonesia" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=Great+Vibes&family=Jost:wght@300;400&display=swap" rel="stylesheet" />
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body { background: #fff; }
      .rose-arch {
        --ra-green: #758966;
        --ra-ink: #101010;
        --ra-soft: #e6d8d5;
        --ra-pink: #eab7c4;
        font-family: 'Jost', sans-serif;
        color: var(--ra-ink);
        min-height: 100svh;
        background: #fff;
      }
      .ra-lang {
        position: fixed;
        top: 18px;
        right: 18px;
        z-index: 20;
        display: flex;
        border: 1px solid rgba(117,137,102,0.2);
        border-radius: 999px;
        overflow: hidden;
        background: rgba(255,255,255,0.72);
        backdrop-filter: blur(14px);
      }
      .ra-lang button {
        border: 0;
        background: transparent;
        color: rgba(16,16,16,0.55);
        font-size: 10px;
        letter-spacing: 0.18em;
        padding: 9px 13px;
      }
      .ra-lang .on {
        background: var(--ra-green);
        color: #fff;
      }
      .ra-cover {
        position: fixed;
        inset: 0;
        z-index: 10;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        padding: clamp(28px, 5vh, 62px) 0;
        background: #f3f3f3;
        transition: opacity 0.8s ease, transform 0.8s cubic-bezier(0.16,1,0.3,1);
      }
      .rose-arch.opened .ra-cover {
        opacity: 0;
        pointer-events: none;
        transform: scale(1.035);
      }
      .ra-reference-cover {
        position: absolute;
        top: clamp(28px, 5vh, 62px);
        bottom: clamp(28px, 5vh, 62px);
        left: 50%;
        width: min(82vw, 470px);
        height: auto;
        transform: translateX(-50%);
        object-fit: cover;
        object-position: center;
        display: block;
        filter: saturate(0.95) contrast(1.02);
        border-radius: 8px;
        box-shadow: 0 32px 90px rgba(0,0,0,0.12);
      }
      .ra-watercolor-mass {
        fill: #f1c8d0;
        opacity: 0.1;
        filter: blur(12px);
        mix-blend-mode: multiply;
      }
      .ra-png-florals {
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        overflow: hidden;
      }
      .ra-png {
        position: absolute;
        width: min(72vw, 390px);
        filter: saturate(0.9) contrast(1.06);
        opacity: 0.88;
        mix-blend-mode: multiply;
      }
      .ra-png-top-left {
        top: -54px;
        left: -92px;
        transform: rotate(6deg) scale(1.14);
      }
      .ra-png-top-right {
        top: -58px;
        right: -94px;
        transform: scaleX(-1) rotate(6deg) scale(1.14);
      }
      .ra-png-bottom-left {
        bottom: -94px;
        left: -96px;
        transform: rotate(-10deg) scale(1.05);
      }
      .ra-png-bottom-right {
        bottom: -92px;
        right: -96px;
        transform: scaleX(-1) rotate(-10deg) scale(1.05);
      }
      .ra-png-bottom-mid {
        width: min(78vw, 430px);
        left: 50%;
        bottom: -122px;
        transform: translateX(-50%) scale(1.02);
        opacity: 0.76;
      }
      .ra-arch {
        fill: none;
        stroke: rgba(215,194,190,0.82);
        stroke-width: 4;
      }
      .ra-arch.soft {
        stroke-width: 2;
        opacity: 0.48;
      }
      .ra-arch-dot {
        fill: none;
        stroke: rgba(215,194,190,0.88);
        stroke-width: 4;
      }
      .ra-sprig path {
        fill: none;
        stroke: rgba(50,96,56,0.5);
        stroke-width: 2.4;
        stroke-linecap: round;
      }
      .ra-flower,
      .ra-sprig {
        transform-box: fill-box;
        transform-origin: center;
        animation: raFloat 8s ease-in-out infinite;
      }
      .ra-flower:nth-of-type(2n) { animation-delay: -2.4s; }
      .ra-flower:nth-of-type(3n) { animation-delay: -4.1s; }
      .ra-card {
        position: relative;
        z-index: 3;
        width: min(62vw, 340px);
        min-height: min(44svh, 410px);
        margin-top: clamp(14px, 3vh, 42px);
        padding: clamp(34px, 5vh, 48px) 26px 30px;
        border-radius: 22px;
        background: rgba(255,255,255,0.94);
        box-shadow: 0 22px 54px rgba(0,0,0,0.16);
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
      }
      .ra-card::before {
        content: '';
        position: absolute;
        inset: 12px;
        border-radius: 20px;
        border: 1px solid rgba(117,137,102,0.13);
        pointer-events: none;
      }
      .ra-card-corner {
        position: absolute;
        width: 48px;
        height: 48px;
        border-color: rgba(120,122,111,0.24);
        pointer-events: none;
      }
      .ra-card-corner-tl {
        top: 22px;
        left: 22px;
        border-top: 2px solid;
        border-left: 2px solid;
        border-radius: 12px 0 0 0;
      }
      .ra-card-corner-tr {
        top: 22px;
        right: 22px;
        border-top: 2px solid;
        border-right: 2px solid;
        border-radius: 0 12px 0 0;
      }
      .ra-card-corner-bl {
        bottom: 22px;
        left: 22px;
        border-bottom: 2px solid;
        border-left: 2px solid;
        border-radius: 0 0 0 12px;
      }
      .ra-card-corner-br {
        bottom: 22px;
        right: 22px;
        border-bottom: 2px solid;
        border-right: 2px solid;
        border-radius: 0 0 12px 0;
      }
      .ra-title {
        font-family: 'Cormorant Garamond', serif;
        font-weight: 500;
        font-size: clamp(17px, 4.8vw, 26px);
        letter-spacing: 0.18em;
        text-transform: uppercase;
        margin-bottom: clamp(24px, 3.4vh, 34px);
        color: rgba(16,16,16,0.74);
      }
      .ra-plaque {
        width: min(47vw, 230px);
        aspect-ratio: 1.42;
        background: var(--ra-green);
        color: #fff;
        clip-path: polygon(18% 0, 82% 0, 100% 22%, 100% 78%, 82% 100%, 18% 100%, 0 78%, 0 22%);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        box-shadow: 0 18px 42px rgba(67,89,61,0.12);
      }
      .ra-plaque span {
        font-family: 'Great Vibes', 'Cormorant Garamond', serif;
        font-size: clamp(34px, 8vw, 50px);
        line-height: 0.82;
      }
      .ra-plaque i {
        display: block;
        width: 74%;
        height: 2px;
        background: rgba(8,8,8,0.78);
      }
      .ra-card-details {
        margin-top: clamp(24px, 3.2vh, 34px);
        display: grid;
        gap: 9px;
        color: rgba(16,16,16,0.64);
        font-size: clamp(12px, 3.2vw, 16px);
        line-height: 1.25;
      }
      .ra-card-details p:first-child {
        font-size: clamp(15px, 3.8vw, 19px);
        color: rgba(16,16,16,0.72);
      }
      .ra-card-details p:last-child {
        margin-top: 4px;
      }
      .ra-open-btn {
        position: relative;
        z-index: 3;
        margin-top: clamp(20px, 3.2vh, 34px);
        min-width: 142px;
        min-height: 48px;
        border: 0;
        border-radius: 999px;
        background: var(--ra-green);
        color: #fff;
        box-shadow: 0 14px 32px rgba(67,89,61,0.24);
        font-family: 'Jost', sans-serif;
        font-size: 10px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        cursor: pointer;
      }
      @media (max-width: 430px) {
        .ra-cover {
          padding: 16px 0 22px;
        }
        .ra-reference-cover {
          top: 16px;
          bottom: 22px;
          width: min(86vw, 360px);
        }
        .ra-card {
          width: 65vw;
          min-height: 49svh;
          margin-top: 0;
          padding: 34px 18px 30px;
        }
        .ra-plaque {
          width: 50vw;
        }
        .ra-card-details {
          gap: 8px;
        }
      }
      .ra-content {
        display: none;
        background:
          radial-gradient(ellipse at 20% 2%, rgba(234,183,196,0.16), transparent 24%),
          #fff;
      }
      .rose-arch.opened .ra-content {
        display: block;
        animation: raContentIn 0.8s ease both;
      }
      .ra-section {
        padding: 80px 28px;
      }
      .ra-kicker {
        color: var(--ra-green);
        font-size: 10px;
        letter-spacing: 0.24em;
        text-transform: uppercase;
      }
      .ra-section h1,
      .ra-section h2 {
        margin-top: 18px;
        font-family: 'Cormorant Garamond', serif;
        font-weight: 400;
        font-size: clamp(48px, 14vw, 86px);
        line-height: 0.95;
      }
      .ra-section h1 span {
        color: var(--ra-green);
      }
      .ra-section p:last-child {
        max-width: 560px;
        margin-top: 26px;
        font-family: 'Cormorant Garamond', serif;
        font-size: 22px;
        font-style: italic;
        line-height: 1.48;
        color: rgba(16,16,16,0.68);
      }
      .ra-save {
        padding: 78px 28px;
        background: #f6f7f1;
        display: grid;
        gap: 12px;
      }
      .ra-save strong {
        display: block;
        font-family: 'Cormorant Garamond', serif;
        font-size: clamp(130px, 36vw, 220px);
        font-weight: 400;
        line-height: 0.8;
      }
      .ra-save p,
      .ra-save span {
        color: var(--ra-green);
        font-size: 11px;
        letter-spacing: 0.24em;
        text-transform: uppercase;
      }
      .ra-save a {
        min-height: 50px;
        display: grid;
        place-items: center;
        border-radius: 999px;
        text-decoration: none;
        background: var(--ra-green);
        color: #fff;
        font-size: 10px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }
      .ra-save a:last-child {
        background: transparent;
        color: var(--ra-green);
        border: 1px solid rgba(117,137,102,0.28);
      }
      .ra-gallery {
        padding: 70px 0;
      }
      .ra-gallery .ra-kicker {
        padding: 0 28px 24px;
      }
      .ra-gallery div {
        display: flex;
        gap: 14px;
        overflow-x: auto;
        padding: 0 28px;
        scrollbar-width: none;
      }
      .ra-gallery div::-webkit-scrollbar { display: none; }
      .ra-gallery img {
        flex: 0 0 230px;
        width: 230px;
        aspect-ratio: 3 / 4;
        object-fit: cover;
        border-radius: 180px 180px 12px 12px;
        filter: sepia(0.08) saturate(0.9);
      }
      .ra-footer {
        padding: 60px 24px 72px;
        text-align: center;
        font-family: 'Great Vibes', 'Cormorant Garamond', serif;
        font-size: 48px;
        color: var(--ra-green);
      }
      @keyframes raFloat {
        0%, 100% { transform: translate3d(0,0,0) rotate(0deg) scale(1); }
        50% { transform: translate3d(0,-8px,0) rotate(1.5deg) scale(1.025); }
      }
      @keyframes raContentIn {
        from { opacity: 0; transform: translateY(18px); }
        to { opacity: 1; transform: translateY(0); }
      }
    </style>
  </head>
  <body>
    <RoseArchInvitation client:load />
  </body>
</html>
